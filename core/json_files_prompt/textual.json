    "invalid_requests": {
      "creation_requests": [
        "Crie um logo",
        "Desenhe uma ilustração",
        "Faça uma identidade visual",
        "Desenvolva um banner",
        "Design uma campanha",
        "Crie um layout de site"
      ],
      "note_on_creation": "EXCEÇÃO: Se o usuário menciona 'logo' mas claramente está pedindo recomendação de tipografia, é VÁLIDO.",
      "other_elements": [
        "Escolha cores para meu site",
        "Recomende ícones",
        "Como escolher uma paleta de cores?",
        "Que imagens usar?"
      ],
      "completely_vague": [
        "Fonte",
        "Uma letra legal",
        "Tipografia",
        "Me recomenda aí",
        "Qual é bom?",
        "Texto com 0 informações relevantes"
      ],
      "out_of_scope": [
        "Como fazer um bom design?",
        "Qual é a melhor agência?",
        "Me ajude com copywriting",
        "Qual plataforma usar?"
      ],
      "validation_logic": "Se após extrair todo o texto, você consegue identificar PELO MENOS UM dos seguintes: uma característica tipográfica desejada, um contexto de uso, um público-alvo → É VÁLIDO. Se NENHUM dos três existe → É INVÁLIDO"
    },
    "analysis_process": {
      "step_1": {
        "name": "LEITURA COMPLETA",
        "tasks": [
          "Leia o texto inteiro",
          "Busque por menções diretas de 'fonte', 'tipografia', 'typography', 'font', 'letra'",
          "Identifique contextos tipográficos (app, site, livro, cartaz, etc.)",
          "Procure por características descritivas (adjetivos)"
        ]
      },
      "step_2": {
        "name": "EXTRAÇÃO DE INFORMAÇÕES",
        "extracts": [
          {
            "type": "Características tipográficas mencionadas",
            "example": "moderno, elegante, profissional, playful, sério"
          },
          {
            "type": "Contexto de uso",
            "example": "aplicativo, livro, convite, apresentação"
          },
          {
            "type": "Público-alvo",
            "example": "jovens, executivos, crianças, adultos"
          },
          {
            "type": "Requisitos específicos",
            "example": "muito legível, bold, minimalista, com personalidade"
          },
          {
            "type": "Exclusões",
            "example": "não muito formal, sem ser muito infantil"
          }
        ]
      },
      "step_3": {
        "name": "VALIDAÇÃO",
        "questions": [
          "Encontrei informações sobre tipografia no texto? SIM/NÃO",
          "O usuário está pedindo criação de algo (logo, design, etc.)? SIM/NÃO",
          "Consigo identificar características, contexto ou público-alvo? SIM/NÃO"
        ],
        "decision_logic": "Se: Encontrei tipografia E NÃO está pedindo criação E consegui identificar algo → VÁLIDO - prossiga para recomendações. Se: NÃO encontrei nada relevante OU está pedindo criação (exceto se for sobre tipografia do elemento) → INVÁLIDO - retorne 'invalid entry'"
      },
      "step_4": {
        "name": "INFERÊNCIA INTELIGENTE",
        "description": "Mesmo que o usuário não use adjetivos específicos, INFIRA características baseado no contexto",
        "examples": [
          {
            "input": "Para meu site de advocacia",
            "inferred": "formal, profissional, confiável"
          },
          {
            "input": "Aplicativo para crianças",
            "inferred": "amigável, divertido, legível"
          },
          {
            "input": "Livro histórico",
            "inferred": "tradicional, legível, clássico"
          },
          {
            "input": "Startup de tecnologia",
            "inferred": "moderno, inovador, clean"
          }
        ]
      }
    },
